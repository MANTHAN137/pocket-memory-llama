<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="6dp" android:background="@drawable/task_notification_background">
    <LinearLayout android:id="@+id/task_notify_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="4dp" android:paddingTop="2dp" android:paddingBottom="2dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/task_notify_title1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/editorial_blue" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/task_notify_date1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/muted_ink" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <Button android:id="@+id/task_notify_done1" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="48dp" android:text="✓" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/editorial_blue" android:background="@drawable/task_done_button" android:backgroundTint="@null" android:padding="0dp" android:layout_marginStart="8dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/task_notify_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="4dp" android:paddingTop="2dp" android:paddingBottom="2dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/task_notify_title2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/editorial_blue" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/task_notify_date2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/muted_ink" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <Button android:id="@+id/task_notify_done2" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="48dp" android:text="✓" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/editorial_blue" android:background="@drawable/task_done_button" android:backgroundTint="@null" android:padding="0dp" android:layout_marginStart="8dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/task_notify_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="4dp" android:paddingTop="2dp" android:paddingBottom="2dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/task_notify_title3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/editorial_blue" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/task_notify_date3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/muted_ink" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <Button android:id="@+id/task_notify_done3" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:minHeight="48dp" android:text="✓" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/editorial_blue" android:background="@drawable/task_done_button" android:backgroundTint="@null" android:padding="0dp" android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
