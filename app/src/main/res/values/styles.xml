<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/warm_ivory</item>
        <item name="android:colorBackground">@color/warm_ivory</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/warm_ivory</item>
        <item name="android:navigationBarColor">@color/warm_ivory</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/editorial_blue</item>
        <item name="android:colorControlActivated">@color/editorial_blue</item>
        <item name="android:textColorPrimary">@color/editorial_blue</item>
        <item name="android:textColorSecondary">@color/muted_ink</item>
        <item name="android:textColorHighlight">#55FF88D1</item>
        <item name="android:alertDialogTheme">@style/MemoryDialogTheme</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="MemoryDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/editorial_blue</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:textColorPrimary">@color/editorial_blue</item>
        <item name="android:textColorSecondary">@color/muted_ink</item>
        <item name="android:textColorHighlight">#55FF88D1</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/MemoryDialogPrimaryAction</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/MemoryDialogAction</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/MemoryDialogAction</item>
    </style>
    <style name="MemoryDialogAction" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/dialog_button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/dialog_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">15dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="MemoryDialogPrimaryAction" parent="MemoryDialogAction">
        <item name="android:background">@drawable/dialog_button_primary</item>
    </style>
</resources>
